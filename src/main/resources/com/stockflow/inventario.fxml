<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockflow.controller.InventarioController" stylesheets="@styles.css" styleClass="main-root">
    <top>
        <HBox styleClass="header">
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <Image url="@logo.png" />
                </ImageView>
                <Label text="STOCKFLOW" styleClass="header-title" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="Inicio" styleClass="nav-button" onAction="#navInicio" />
                <Button text="Inventario" styleClass="active-nav" onAction="#navInventario" />
                <Button text="Recomendaciones" styleClass="nav-button" onAction="#navRecomendaciones" />
                <Button text="Transferencias" styleClass="nav-button" onAction="#navTransferencias" />
                <Button text="Salir" styleClass="btn-logout" onAction="#navSalir" />
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="25.0" styleClass="content-area" VBox.vgrow="ALWAYS">
            <Label text="Inventario consolidado" styleClass="page-title" />
            
            <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                <VBox spacing="5.0">
                    <Label text="Producto:" />
                    <ComboBox fx:id="cmbProducto" prefWidth="180" />
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Sucursal:" />
                    <ComboBox fx:id="cmbSucursal" prefWidth="180" />
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Estado:" />
                    <ComboBox fx:id="cmbEstado" prefWidth="180" />
                </VBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <Button text="Generar recomendaciones" onAction="#generarRecomendaciones" styleClass="secondary-action" prefHeight="35" />
                <Button text="Buscar" onAction="#buscar" styleClass="action-button" prefHeight="35" />
            </HBox>
            
            <TableView fx:id="tablaInventario" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" />
                    <TableColumn fx:id="colSucursal" text="Sucursal" />
                    <TableColumn fx:id="colActual" text="Stock actual" />
                    <TableColumn fx:id="colMinimo" text="Stock mínimo" />
                    <TableColumn fx:id="colMaximo" text="Stock máximo" />
                    <TableColumn fx:id="colEstado" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
