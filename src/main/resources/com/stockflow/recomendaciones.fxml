<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockflow.controller.RecomendacionesController"
            stylesheets="@styles.css" styleClass="main-root">
    <top>
        <HBox styleClass="header">
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true"><Image url="@logo.png" /></ImageView>
                <Label text="STOCKFLOW" styleClass="header-title" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="15.0" alignment="CENTER">
                <Button text="Inicio" styleClass="nav-button" onAction="#navInicio" />
                <Button text="Inventario" styleClass="nav-button" onAction="#navInventario" />
                <Button text="Recomendaciones" styleClass="active-nav" onAction="#navRecomendaciones" />
                <Button text="Transferencias" styleClass="nav-button" onAction="#navTransferencias" />
                <Button text="Salir" styleClass="btn-logout" onAction="#navSalir" />
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0" styleClass="content-area" VBox.vgrow="ALWAYS">
            <VBox spacing="4.0">
                <Label text="Recomendaciones" styleClass="page-title" />
                <Label text="Evaluá oportunidades de redistribución antes de crear una transferencia." styleClass="page-subtitle" />
            </VBox>
            <TableView fx:id="tablaRecomendaciones" minHeight="150" prefHeight="235" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" />
                    <TableColumn fx:id="colOrigen" text="Origen" />
                    <TableColumn fx:id="colDestino" text="Destino" />
                    <TableColumn fx:id="colCantidad" text="Cantidad" />
                    <TableColumn fx:id="colEstado" text="Estado" />
                </columns>
            </TableView>
            <VBox styleClass="detail-card">
                <VBox fx:id="boxDetalles" spacing="12.0" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" styleClass="detail-header">
                        <VBox spacing="2.0">
                            <Label text="Detalle de recomendación" styleClass="detail-title" />
                            <Label fx:id="lblProductoDetalle" text="Producto" styleClass="detail-product" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblEstadoDetalle" text="PENDIENTE" styleClass="detail-status" />
                    </HBox>
                    <HBox spacing="18.0" alignment="TOP_LEFT" styleClass="detail-content">
                        <VBox spacing="7.0" styleClass="detail-section" HBox.hgrow="ALWAYS">
                            <Label text="ORIGEN" styleClass="detail-eyebrow" />
                            <Label fx:id="lblOrigenDetalle" text="Sucursal" styleClass="detail-highlight" />
                            <HBox spacing="5.0"><Label text="Stock actual" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblStockOrigen" text="0" styleClass="detail-value" /></HBox>
                            <HBox spacing="5.0"><Label text="Máximo" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblMaximo" text="0" styleClass="detail-value" /></HBox>
                            <HBox spacing="5.0"><Label text="Excedente" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblExcedente" text="0" styleClass="detail-value" /></HBox>
                        </VBox>
                        <VBox spacing="7.0" styleClass="detail-section" HBox.hgrow="ALWAYS">
                            <Label text="DESTINO" styleClass="detail-eyebrow" />
                            <Label fx:id="lblDestinoDetalle" text="Sucursal" styleClass="detail-highlight" />
                            <HBox spacing="5.0"><Label text="Stock actual" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblStockDestino" text="0" styleClass="detail-value" /></HBox>
                            <HBox spacing="5.0"><Label text="Mínimo" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblMinimo" text="0" styleClass="detail-value" /></HBox>
                            <HBox spacing="5.0"><Label text="Necesidad" styleClass="detail-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="lblNecesidad" text="0" styleClass="detail-value" /></HBox>
                        </VBox>
                        <VBox spacing="9.0" styleClass="detail-section" HBox.hgrow="ALWAYS">
                            <Label text="PROPUESTA" styleClass="detail-eyebrow" />
                            <Label fx:id="lblRecomendada" text="0" styleClass="detail-highlight" />
                            <Label text="unidades recomendadas" styleClass="detail-label" />
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" styleClass="detail-footer">
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10.0" alignment="CENTER_RIGHT" styleClass="detail-actions">
                            <Button fx:id="btnRechazar" text="Rechazar" onAction="#rechazar" styleClass="btn-reject" />
                            <Button fx:id="btnAprobar" text="Aprobar" onAction="#aprobar" styleClass="action-button" />
                        </HBox>
                    </HBox>
                </VBox>
                <Label fx:id="lblPlaceholder" text="Seleccioná una recomendación para consultar su detalle y tomar una decisión."
                       wrapText="true" styleClass="detail-empty" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
